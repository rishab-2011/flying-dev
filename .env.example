# ---------------------------------------------------------------------------
# Database (Neon Postgres)
#
# DATABASE_URL is the POOLED connection string — the one whose host contains
# "-pooler". The app opens a connection per request, so it must go through the
# pooler or Neon runs out of connections.
#
# DIRECT_URL is the same string WITHOUT "-pooler". Migrations can't run through
# a pooler, so Prisma uses this one for them.
#
# Append ?sslmode=require to both. Neon shows you both strings in its dashboard.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out. Never commit the real value.
SESSION_SECRET="change-me-to-a-long-random-string"

# The business WhatsApp and support number. WhatsApp wants international
# format with no punctuation; the support number is shown to customers as
# written here.
NEXT_PUBLIC_WHATSAPP_NUMBER="918587949104"
NEXT_PUBLIC_SUPPORT_PHONE="+91 85879 49104"

# Your live URL, used to build canonical links, the sitemap and the WhatsApp
# share card. OPTIONAL on Netlify: if this is unset the site falls back to
# Netlify's own URL / DEPLOY_PRIME_URL, which are always correct and give
# deploy previews their own address instead of production's. Set it only once
# you point a custom domain at the site, so the canonicals name that domain
# rather than the netlify.app one.
# NEXT_PUBLIC_SITE_URL="https://flyingdev.in"

# The admin account created by `npm run seed`. Change BOTH before going live.
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD="change-this-before-deploying"

# --- Datadog (optional) -------------------------------------------------------
# Browser monitoring: which pages are slow, which are erroring, what a customer
# tapped before it broke. Leave BOTH unset and the SDK never loads and the
# consent banner never appears -- the site behaves exactly as it does today.
#
# Get these from Datadog: Digital Experience > Real User Monitoring >
# Applications > New Application (pick "Browser"). The client token is meant to
# be public; it is write-only and cannot read your Datadog data. Do NOT put a
# Datadog *API key* here -- that one is a secret and does not belong in a
# browser bundle.
#
# Server-side APM (dd-trace) is NOT usable on Netlify: it needs the Datadog
# Agent, and Netlify Functions cannot run one or attach the Lambda extension.
# NEXT_PUBLIC_DD_APPLICATION_ID=""
# NEXT_PUBLIC_DD_CLIENT_TOKEN=""
# Regional endpoint. Defaults to datadoghq.com (US1), which is where our
# Datadog organisation lives. This is NOT a latency choice: it must match the
# region the account was created in, which you can read off the console's own
# URL (app.datadoghq.com = US1, app.datadoghq.eu = EU1, ap1.datadoghq.com =
# AP1, and so on). Set it wrong and the SDK sends to a region the account
# cannot read -- no error, just an empty dashboard.
# NEXT_PUBLIC_DD_SITE="datadoghq.com"

# Which Datadog environment this deploy reports as. Normally leave this unset:
# it is derived at build time in next.config.mjs, so a Netlify production
# deploy reports "production" and deploy previews and branch builds report
# "sandbox". That separation matters -- NODE_ENV is "production" for every
# built deploy, so without it a preview's errors and page timings land next to
# real customer traffic. Set it only to force a specific value, e.g. "staging".
# NEXT_PUBLIC_DD_ENV="staging"
#
# The release Datadog attributes an error to. Derived from the commit SHA
# (Netlify COMMIT_REF, GitHub Actions GITHUB_SHA, Amplify AWS_COMMIT_ID).
# NEXT_PUBLIC_DD_VERSION=""
