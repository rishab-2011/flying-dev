# Database. SQLite for local development; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The WhatsApp number bookings are routed to, in international format, digits only.
# 91 is the India country code. Replace with your own business number.
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_SUPPORT_PHONE="+91 99999 99999"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeded admin account. Change both before deploying anywhere public.
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD="flyingdev-admin"
