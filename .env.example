# ---------------------------------------------------------------------------
# Database (Neon Postgres)
#
# DATABASE_URL is the POOLED connection string — the one whose host contains
# "-pooler". The app opens a connection per request, so it must go through the
# pooler or Neon runs out of connections.
#
# DIRECT_URL is the same string WITHOUT "-pooler". Migrations can't run through
# a pooler, so Prisma uses this one for them.
#
# Append ?sslmode=require to both. Neon shows you both strings in its dashboard.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out. Never commit the real value.
SESSION_SECRET="change-me-to-a-long-random-string"

# The WhatsApp number bookings are routed to, international format, digits only.
# 91 is the India country code. Replace with your business number.
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_SUPPORT_PHONE="+91 99999 99999"

# Your live URL. Used for SEO metadata, so set it to the real domain.
NEXT_PUBLIC_SITE_URL="https://flyingdev.netlify.app"

# The admin account created by `npm run seed`. Change BOTH before going live.
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD="change-this-before-deploying"
