{
  "name": "flyingdev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && node scripts/seed-on-build.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx tests/site-url.ts && node tests/e2e.mjs && node tests/rate-limit.mjs && node tests/datadog.mjs",
    "test:datadog-configured": "MODE=configured node tests/datadog.mjs",
    "shots": "node tests/screenshots.mjs",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@datadog/browser-logs": "^7.13.0",
    "@datadog/browser-rum": "^7.13.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "5.9"
  }
}
